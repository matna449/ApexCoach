# Database
DATABASE_URL=sqlite:///./apex_coach.db

# Encryption — passphrase; Fernet key for oauth_tokens derived via PBKDF2HMAC, see docs/adr/0005
APEX_ENCRYPTION_KEY=

# WHOOP OAuth — register an app at developer.whoop.com (docs/adr/0018)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://matna449.github.io/ApexCoach/callback.html

# Strava OAuth — register an app at strava.com/settings/api (docs/adr/0019)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://matna449.github.io/ApexCoach/callback.html
